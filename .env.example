POSTGRES_USER=kalkulation
POSTGRES_PASSWORD=kalkulation_secret
POSTGRES_DB=kalkulation

# Backend (lokal aus backend/ oder Projektroot)
DATABASE_URL=postgresql://postgres:admin123@localhost:5432/kalkulationstool
# Pflicht für docker compose (production). Muss ungleich change-me-in-production sein.
JWT_SECRET_KEY=super-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Docker: docker compose up --build
#   → APP_ENV=production, alembic upgrade head, dann uvicorn (keine Seeds)
# Dev-Override mit Reload:
#   docker compose -f docker-compose.yml -f docker-compose.dev.yml up --build


# Alternativ werden auch SECRET_KEY und ALGORITHM akzeptiert

# Lokaler Admin nur per CLI (nie beim App-Startup), z. B.:
#   set LOCAL_ADMIN_SEED_ENABLED=true
#   set LOCAL_ADMIN_EMAIL=j.zende@zende-consultant.de
#   set LOCAL_ADMIN_PASSWORD=...
#   cd backend && python -m app.scripts.seed_admin
# LOCAL_ADMIN_SEED_ENABLED=false
# LOCAL_ADMIN_EMAIL=
# LOCAL_ADMIN_PASSWORD=

# TOP_LEVEL-Zuschlagssätze (vvgk/gewinn/skonto) nur per CLI, nie Startup/Alembic:
#   cd backend && python -m app.scripts.seed_top_level_markup_rates
# Voraussetzung: lokale DATABASE_URL (localhost / 127.0.0.1 / sqlite).
# Bestehende GEMEINKOSTEN-/GEWINN-/VERSCHROTTUNG-Sätze bleiben unverändert.
